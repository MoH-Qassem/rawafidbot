# انسخ إلى .env محلياً أو عيّن المتغيرات في لوحة الاستضافة.
# لا تضع أسراراً حقيقية في هذا الملف.

# Telegram Bot Token (من BotFather) — ضع القيمة الحقيقية في .env فقط
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# CEO Telegram User ID (مطلوب)
CEO_TELEGRAM_ID=REPLACE_WITH_CEO_NUMERIC_ID

# اختياري للتجارب فقط — لا تستخدمه على الإنتاج
# ALLOW_ENV_MEMBER_BOOTSTRAP=0
# MEMBER_TELEGRAM_IDS=

# الحد الأقصى لأعضاء الشركة
MAX_MEMBERS=5

# قاعدة البيانات
# للاستضافة (FadeHost): استخدم المسار الدائم
DB_PATH=/data/rawafed.db
# للتطوير المحلي (بديل إن لم يُضبط DB_PATH):
# DATABASE_URL=sqlite:///data/rawafed.db
# TEST_DATABASE_URL=sqlite:///data/test.db

# الهوية التشغيلية (تظهر في السجلات)
BUILD_ID=2.1.0+local
LOG_LEVEL=INFO

# المنطقة الزمنية للجدولة
TIMEZONE=Asia/Damascus

# جدولة التقارير
# WEEKLY_REPORT_DAY: 0=أحد … 5=جمعة … 6=سبت
WEEKLY_REPORT_DAY=5
WEEKLY_REPORT_HOUR=18
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=9
